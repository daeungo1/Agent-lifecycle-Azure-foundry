{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "13697675084963280182"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all Azure AI Search security boundaries."
      }
    },
    "namePrefix": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20,
      "metadata": {
        "description": "Prefix used for deterministic naming in tags and fallback naming logic."
      }
    },
    "searchServices": {
      "type": "array",
      "metadata": {
        "description": "Search boundary definitions. Foundry project/model/agents are intentionally managed only by azure.yaml infra.provider=microsoft.foundry."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Optional tags applied to search services."
      }
    }
  },
  "variables": {
    "mergedTags": "[union(parameters('tags'), createObject('managedBy', 'bicep', 'workload', 'foundry-iq', 'namePrefix', parameters('namePrefix')))]"
  },
  "resources": [
    {
      "copy": {
        "name": "searchBoundaryModules",
        "count": "[length(parameters('searchServices'))]"
      },
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('search-{0}', parameters('searchServices')[copyIndex()].boundary)]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[parameters('searchServices')[copyIndex()].name]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('mergedTags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.45.15.27210",
              "templateHash": "14886394553446582498"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60,
              "metadata": {
                "description": "Azure AI Search service name."
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Deployment location."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Tags applied to the service."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Search/searchServices",
              "apiVersion": "2023-11-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "basic"
              },
              "identity": {
                "type": "SystemAssigned"
              },
              "tags": "[parameters('tags')]",
              "properties": {
                "replicaCount": 1,
                "partitionCount": 1,
                "semanticSearch": "free",
                "disableLocalAuth": true,
                "publicNetworkAccess": "enabled"
              }
            }
          ],
          "outputs": {
            "name": {
              "type": "string",
              "value": "[parameters('name')]"
            },
            "endpoint": {
              "type": "string",
              "value": "[format('https://{0}.search.windows.net', parameters('name'))]"
            },
            "principalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Search/searchServices', parameters('name')), '2023-11-01', 'full').identity.principalId]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "searchEndpoints": {
      "type": "array",
      "copy": {
        "count": "[length(parameters('searchServices'))]",
        "input": {
          "boundary": "[parameters('searchServices')[copyIndex()].boundary]",
          "endpoint": "[reference(resourceId('Microsoft.Resources/deployments', format('search-{0}', parameters('searchServices')[copyIndex()].boundary)), '2025-04-01').outputs.endpoint.value]"
        }
      }
    }
  }
}